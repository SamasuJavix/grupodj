---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
import prisma from "../../../lib/prisma";

export const prerender = false;

// Obtener parámetros de búsqueda y filtro
const search = Astro.url.searchParams.get("q") || "";
const selectedCategory = Astro.url.searchParams.get("category") || "";
const selectedBrand = Astro.url.searchParams.get("brand") || "";
const selectedStock = Astro.url.searchParams.get("stock") || "";

// Consultar categorías para los filtros
const categories = await prisma.category.findMany({ orderBy: { name: "asc" } });

// Consultar marcas únicas
const allBrands = await prisma.product.findMany({
	select: { brand: true },
	distinct: ["brand"],
	where: { brand: { not: null } }
});
const brands = allBrands.map(b => b.brand).filter(Boolean);

let stockFilter = {};
if (selectedStock === "in_stock") stockFilter = { stock: { gt: 0 } };
if (selectedStock === "out_of_stock") stockFilter = { stock: 0 };

// Consultar productos desde Hostinger MySQL
const products = await prisma.product.findMany({
	where: {
		AND: [
			search
				? {
						OR: [
							{ name: { contains: search } },
							{ sku: { contains: search } },
						],
				  }
				: {},
			selectedCategory ? { categoryId: selectedCategory } : {},
			selectedBrand ? { brand: selectedBrand } : {},
			stockFilter,
		],
	},
	include: {
		category: true,
		images: { orderBy: { displayOrder: "asc" }, take: 1 },
	},
	orderBy: { createdAt: "desc" },
});
---

<AdminLayout title="Gestión de Productos | Admin Grupo DJ">
	<div class="space-y-6">
		<!-- Header Actions -->
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-base-100 p-6 rounded-3xl border border-base-300">
			<div>
				<h2 class="text-2xl font-black uppercase text-base-content tracking-tight italic">Catálogo de Productos</h2>
				<p class="text-base-content/70 text-xs font-medium">Gestión directa de inventario y precios en MySQL Hostinger.</p>
			</div>

			<a
				href="/admin/productos/nuevo"
				class="bg-primary hover:bg-primary/90 text-base-content font-black py-3 px-6 rounded-xl uppercase text-xs tracking-wider shadow-lg shadow-primary/20 flex items-center gap-2"
			>
				<Icon name="lucide:plus" class="w-4 h-4" />
				Agregar Producto
			</a>
		</div>

		<!-- Filters & Search Bar -->
		<form method="GET" class="bg-base-100 p-4 rounded-2xl border border-base-300 flex flex-col md:flex-row gap-4 items-center justify-between">
			<div class="relative w-full md:w-96">
				<input
					type="text"
					name="q"
					value={search}
					placeholder="Buscar por Nombre o SKU..."
					class="w-full bg-base-100 border border-base-300 rounded-xl px-4 py-2.5 text-sm text-base-content focus:outline-none focus:border-primary pl-10"
				/>
				<Icon name="lucide:search" class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
			</div>

			<div class="flex flex-wrap w-full md:w-auto items-center gap-3">
				<select
					name="category"
					class="bg-base-100 border border-base-300 text-base-content/80 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary"
				>
					<option value="">Todas las Categorías</option>
					{categories.map((c) => (
						<option value={c.id} selected={selectedCategory === c.id}>{c.name}</option>
					))}
				</select>

				<select
					name="brand"
					class="bg-base-100 border border-base-300 text-base-content/80 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary"
				>
					<option value="">Todas las Marcas</option>
					{brands.map((b) => (
						<option value={b} selected={selectedBrand === b}>{b}</option>
					))}
				</select>

				<select
					name="stock"
					class="bg-base-100 border border-base-300 text-base-content/80 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary"
				>
					<option value="">Stock</option>
					<option value="in_stock" selected={selectedStock === "in_stock"}>En Stock</option>
					<option value="out_of_stock" selected={selectedStock === "out_of_stock"}>Agotados</option>
				</select>

				<button type="submit" class="btn btn-sm btn-primary rounded-xl px-5 text-xs uppercase font-bold">
					Filtrar
				</button>
				{(search || selectedCategory || selectedBrand || selectedStock) && (
					<a href="/admin/productos" class="btn btn-sm btn-ghost text-base-content/70 hover:text-base-content text-xs">
						Limpiar
					</a>
				)}
			</div>
		</form>

		<!-- Products Table -->
		<div class="bg-base-100 border border-base-300 rounded-3xl overflow-hidden shadow-xl">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="text-xs uppercase text-base-content/70 bg-base-100/80 border-b border-base-300">
						<tr>
							<th class="p-4">SKU</th>
							<th class="p-4">Producto</th>
							<th class="p-4">Categoría</th>
							<th class="p-4">Precio (S/)</th>
							<th class="p-4">Stock</th>
							<th class="p-4">Estado</th>
							<th class="p-4 text-right">Acciones</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-base-300">
						{products.length === 0 ? (
							<tr>
								<td colspan="7" class="p-8 text-center text-slate-500 font-bold uppercase text-xs tracking-wider">
									No se encontraron productos registrados.
								</td>
							</tr>
						) : (
							products.map((p) => (
								<tr class="hover:bg-base-100/40 transition-colors group" id={`row-${p.id}`}>
									<td class="p-4 font-mono text-xs text-base-content/70 font-bold">{p.sku}</td>
									<td class="p-4 flex items-center gap-3">
										<img
											src={p.images[0]?.imageUrl || "https://images.unsplash.com/photo-1526738549149-8e07eca6c147?w=800"}
											alt={p.name}
											class="w-12 h-12 object-cover rounded-xl bg-base-100 border border-base-300 shrink-0"
										/>
										<div class="flex flex-col">
											<span class="font-bold text-base-content text-sm group-hover:text-primary transition-colors">{p.name}</span>
											{p.badge && <span class="text-[10px] text-primary font-black uppercase tracking-widest">{p.badge}</span>}
										</div>
									</td>
									<td class="p-4 text-base-content/70 text-xs font-semibold">{p.category?.name || "Sin Categoría"}</td>
									<td class="p-4 font-black text-emerald-600 text-base">
										S/ {Number(p.price).toFixed(2)}
										{p.discountPercentage > 0 && (
											<span class="block text-[10px] text-amber-600 font-normal">-{p.discountPercentage}% Desc</span>
										)}
									</td>
									<td class="p-4">
										<span class={`badge font-bold text-xs border-none px-3 py-1 ${p.stock > 5 ? "bg-emerald-100 text-emerald-700" : p.stock > 0 ? "bg-amber-100 text-amber-700" : "bg-red-100 text-red-700"}`}>
											{p.stock} un.
										</span>
									</td>
									<td class="p-4">
										<button
											class="toggle-active-btn inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full cursor-pointer transition-all"
											data-id={p.id}
											data-active={String(p.isActive)}
										>
											{p.isActive ? (
												<span class="bg-emerald-100 text-emerald-700 border border-emerald-300 px-2.5 py-1 rounded-full flex items-center gap-1.5">
													<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Visible
												</span>
											) : (
												<span class="bg-base-200 text-base-content/70 border border-base-300 px-2.5 py-1 rounded-full flex items-center gap-1.5">
													<span class="w-2 h-2 rounded-full bg-slate-400"></span> Oculto
												</span>
											)}
										</button>
									</td>
									<td class="p-4 text-right space-x-2">
										<a
											href={`/admin/productos/${p.id}/editar`}
											class="btn btn-circle btn-sm btn-ghost hover:bg-primary/20 hover:text-primary text-base-content/70"
											title="Editar Producto"
										>
											<Icon name="lucide:edit-3" class="w-4 h-4" />
										</a>
										<button
											class="delete-product-btn btn btn-circle btn-sm btn-ghost hover:bg-red-100 hover:text-red-600 text-base-content/70 cursor-pointer"
											data-id={p.id}
											data-name={p.name}
											title="Eliminar Producto"
										>
											<Icon name="lucide:trash-2" class="w-4 h-4" />
										</button>
									</td>
								</tr>
							))
						)}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<script>
		import { toast } from "sonner";
		import Swal from "sweetalert2";

		// Listener para toggle de visibilidad (Activo / Oculto)
		document.querySelectorAll(".toggle-active-btn").forEach((btn) => {
			btn.addEventListener("click", async () => {
				const id = btn.getAttribute("data-id");
				const currentActive = btn.getAttribute("data-active") === "true";
				const newActive = !currentActive;

				try {
					const res = await fetch(`/api/admin/products/${id}`, {
						method: "PATCH",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ isActive: newActive }),
					});

					const data = await res.json();
					if (data.success) {
						toast.success(`Producto ${newActive ? "visible en la tienda" : "ocultado"}`);
						setTimeout(() => window.location.reload(), 300);
					} else {
						toast.error("No se pudo cambiar la visibilidad");
					}
				} catch (err) {
					toast.error("Error al conectar con la base de datos");
				}
			});
		});

		// Listener para eliminar producto
		document.querySelectorAll(".delete-product-btn").forEach((btn) => {
			btn.addEventListener("click", async () => {
				const id = btn.getAttribute("data-id");
				const name = btn.getAttribute("data-name");

				Swal.fire({
					title: `¿Eliminar "${name}"?`,
					text: "Esta acción no se puede deshacer.",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#d33',
					cancelButtonColor: '#3085d6',
					confirmButtonText: 'Sí, eliminar',
					cancelButtonText: 'Cancelar'
				}).then(async (result) => {
					if (result.isConfirmed) {
						try {
							const res = await fetch(`/api/admin/products/${id}`, {
								method: "DELETE",
							});

							const data = await res.json();
							if (data.success) {
								Swal.fire({
									icon: 'success',
									title: 'Eliminado',
									text: 'El producto ha sido eliminado.',
									timer: 1500,
									showConfirmButton: false
								});
								document.getElementById(`row-${id}`)?.remove();
							} else {
								Swal.fire('Error', data.message || 'No se pudo eliminar', 'error');
							}
						} catch (err) {
							Swal.fire('Error', 'Problema de conexión', 'error');
						}
					}
				});
			});
		});
	</script>
</AdminLayout>
