---
import { Icon } from "astro-icon/components";
import ToasterComponent from "../../components/ui/ToasterComponent";
import "../../styles/global.css";

export const prerender = false;
---

<!doctype html>
<html lang="es" data-theme="javicho">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Iniciar Sesión Admin | Grupo DJ</title>
	</head>
	<body class="bg-base-200 text-base-content min-h-screen flex items-center justify-center p-4 font-sans relative overflow-hidden">
		<!-- Background Glow Effects -->
		<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
		<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>

		<div class="w-full max-w-md bg-base-100/90 backdrop-blur-xl border border-base-300 rounded-3xl p-8 shadow-2xl relative z-10 space-y-8">
			<!-- Header -->
			<div class="text-center space-y-3">
				<div class="inline-flex w-16 h-16 bg-primary/10 border border-primary/20 rounded-2xl items-center justify-center text-primary mb-2 shadow-inner">
					<Icon name="lucide:shield-check" class="w-8 h-8" />
				</div>
				<h1 class="text-3xl font-black uppercase tracking-tight text-base-content italic">Panel Admin</h1>
				<p class="text-base-content/70 text-xs font-medium uppercase tracking-widest">Grupo DJ • Acceso Restringido</p>
			</div>

			<!-- Login Form -->
			<form id="admin-login-form" class="space-y-6">
				<div class="space-y-2">
					<label for="email" class="text-xs font-bold text-base-content/70 uppercase tracking-wider block">Correo Electrónico</label>
					<div class="relative">
						<input
							type="email"
							id="email"
							name="email"
							required
							placeholder="admin@grupodj.com"
							class="w-full bg-base-100 border border-base-300 focus:border-primary rounded-xl px-4 py-3 text-sm text-base-content focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all pl-11"
						/>
						<Icon name="lucide:mail" class="w-5 h-5 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
					</div>
				</div>

				<div class="space-y-2">
					<label for="password" class="text-xs font-bold text-base-content/70 uppercase tracking-wider block">Contraseña</label>
					<div class="relative">
						<input
							type="password"
							id="password"
							name="password"
							required
							placeholder="••••••••"
							class="w-full bg-base-100 border border-base-300 focus:border-primary rounded-xl px-4 py-3 text-sm text-base-content focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all pl-11"
						/>
						<Icon name="lucide:lock" class="w-5 h-5 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
					</div>
				</div>

				<button
					type="submit"
					id="submit-btn"
					class="w-full bg-primary hover:bg-primary/90 text-white font-black py-4 px-6 rounded-xl uppercase tracking-widest text-xs transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2 cursor-pointer"
				>
					<span>Iniciar Sesión</span>
					<Icon name="lucide:arrow-right" class="w-4 h-4" />
				</button>
			</form>

			<div class="pt-4 border-t border-base-300 text-center">
				<a href="/" class="text-xs font-bold text-base-content/70 hover:text-primary transition-colors inline-flex items-center gap-2">
					<Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
					Volver a la tienda
				</a>
			</div>
		</div>

		<ToasterComponent client:load />

		<script>
			import { toast } from "sonner";

			const form = document.getElementById("admin-login-form") as HTMLFormElement;
			const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

			form?.addEventListener("submit", async (e) => {
				e.preventDefault();

				const formData = new FormData(form);
				const email = formData.get("email");
				const password = formData.get("password");

				submitBtn.disabled = true;
				submitBtn.innerHTML = `<span>Verificando...</span>`;

				try {
					const response = await fetch("/api/admin/login", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ email, password }),
					});

					const data = await response.json();

					if (response.ok && data.success) {
						toast.success(data.message);
						setTimeout(() => {
							window.location.href = "/admin";
						}, 500);
					} else {
						toast.error(data.message || "Credenciales incorrectas");
						submitBtn.disabled = false;
						submitBtn.innerHTML = `<span>Iniciar Sesión</span>`;
					}
				} catch (error) {
					console.error("Error al iniciar sesión:", error);
					toast.error("Error al conectar con el servidor");
					submitBtn.disabled = false;
					submitBtn.innerHTML = `<span>Iniciar Sesión</span>`;
				}
			});
		</script>
	</body>
</html>
