---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import ToasterComponent from "../components/ui/ToasterComponent";
import { getAdminSession } from "../lib/auth";

const session = getAdminSession(Astro.cookies);
const currentPath = Astro.url.pathname;
const title = Astro.props.title || "Panel de Administración | Grupo DJ";
---

<!doctype html>
<html lang="es" data-theme="javicho">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-base-200 text-base-content min-h-screen flex flex-col md:flex-row">
		<!-- Sidebar Desktop -->
		<aside class="w-full md:w-64 bg-base-100 border-b md:border-b-0 md:border-r border-base-300 flex flex-col shrink-0">
			<!-- Brand Header -->
			<div class="p-6 border-b border-base-300 flex items-center justify-between">
				<a href="/admin" class="flex items-center gap-3">
					<div class="w-9 h-9 bg-primary rounded-xl flex items-center justify-center text-white shadow-lg shadow-primary/30">
						<Icon name="lucide:shield-check" class="w-5 h-5" />
					</div>
					<div class="flex flex-col">
						<span class="font-black text-lg tracking-tight uppercase text-base-content">Grupo DJ</span>
						<span class="text-[10px] font-bold text-primary tracking-widest uppercase">Panel de Administracion</span>
					</div>
				</a>
			</div>

			<!-- Navigation Links -->
			<nav class="p-4 space-y-1 flex-1">
				<a
					href="/admin"
					class={`flex items-center gap-3 px-4 py-3 rounded-xl font-bold text-sm transition-all ${
						currentPath === "/admin"
							? "bg-primary text-primary-content shadow-md shadow-primary/20"
							: "text-base-content/70 hover:text-base-content hover:bg-base-200"
					}`}
				>
					<Icon name="lucide:layout-dashboard" class="w-5 h-5" />
					Dashboard
				</a>

				<a
					href="/admin/productos"
					class={`flex items-center gap-3 px-4 py-3 rounded-xl font-bold text-sm transition-all ${
						currentPath.startsWith("/admin/productos")
							? "bg-primary text-primary-content shadow-md shadow-primary/20"
							: "text-base-content/70 hover:text-base-content hover:bg-base-200"
					}`}
				>
					<Icon name="lucide:package" class="w-5 h-5" />
					Productos
				</a>

				<a
					href="/admin/productos/nuevo"
					class={`flex items-center gap-3 px-4 py-3 rounded-xl font-bold text-sm transition-all ${
						currentPath === "/admin/productos/nuevo"
							? "bg-primary text-primary-content shadow-md shadow-primary/20"
							: "text-base-content/70 hover:text-base-content hover:bg-base-200"
					}`}
				>
					<Icon name="lucide:plus-circle" class="w-5 h-5" />
					Nuevo Producto
				</a>
			</nav>

			<!-- User Footer / Logout -->
			<div class="p-4 border-t border-base-300 bg-base-200/50">
				{session && (
					<div class="flex items-center justify-between gap-2">
						<div class="flex flex-col min-w-0">
							<span class="text-xs font-bold text-base-content truncate">{session.name}</span>
							<span class="text-[10px] text-base-content/70 truncate">{session.email}</span>
						</div>
						<button
							id="btn-admin-logout"
							class="btn btn-circle btn-sm btn-ghost text-base-content/70 hover:text-error hover:bg-error/10 transition-colors"
							title="Cerrar Sesión"
						>
							<Icon name="lucide:log-out" class="w-4 h-4" />
						</button>
					</div>
				)}
				<div class="mt-3 pt-3 border-t border-base-300 flex justify-between items-center text-[10px] text-base-content/50">
					<a href="/" target="_blank" class="hover:text-primary transition-colors flex items-center gap-1">
						<Icon name="lucide:external-link" class="w-3 h-3" />
						Ver Tienda
					</a>
					<span class="badge badge-xs badge-outline border-base-300 text-base-content/60">MySQL Hostinger</span>
				</div>
			</div>
		</aside>

		<!-- Main Content Area -->
		<div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-base-200">
			<!-- Header Bar -->
			<header class="h-16 bg-primary text-primary-content backdrop-blur-md border-b border-primary/20 px-6 flex items-center justify-between sticky top-0 z-30">
				<h1 class="text-xl font-black uppercase tracking-tight">
					{title.split("|")[0]}
				</h1>

				<div class="flex items-center gap-4">
					<a
						href="/"
						target="_blank"
						class="btn btn-sm btn-outline border-primary-content/50 text-primary-content hover:bg-primary-content hover:text-primary rounded-xl gap-2 text-xs"
					>
						<Icon name="lucide:store" class="w-4 h-4" />
						Ir a la Tienda
					</a>
				</div>
			</header>

			<!-- Page Body -->
			<main class="flex-1 p-6 md:p-10 overflow-y-auto">
				<slot />
			</main>
		</div>

		<ToasterComponent client:load />

		<script>
			import { toast } from "sonner";

			const logoutBtn = document.getElementById("btn-admin-logout");
			logoutBtn?.addEventListener("click", async () => {
				try {
					const res = await fetch("/api/admin/logout", { method: "POST" });
					if (res.ok) {
						toast.success("Sesión cerrada");
						window.location.href = "/admin/login";
					}
				} catch (err) {
					console.error("Error al salir:", err);
				}
			});
		</script>
	</body>
</html>
